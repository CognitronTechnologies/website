# Copy to .env.local for local sending. Never commit actual credentials.
RESEND_API_KEY=
# Use a sender on a domain verified in your Resend account.
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=dickson@cognitron.tech
# Set the final public origin in Vercel, without a path.
# Leave unset for a local preview build; preview indexing stays disabled.
SITE_URL=
